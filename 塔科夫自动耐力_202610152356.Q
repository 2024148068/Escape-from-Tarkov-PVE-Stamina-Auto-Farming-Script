[Script]
Rem bioaji4
IfColor 41,1293,"A9FF",2 Then//主页左下角扩展包区橙色检测
KeyPress "Tab", 1
    Delay 2000
    FindColor 904,496,922,513,"1A1715",intX,intY//查看口袋第一格有没有东西
If intX > 0 And intY > 0 Then
    MoveTo 1756, 90
        LeftClick 1//点击搜索物品
        Delay 1000
        KeyPress "F", 1
        KeyPress "-", 1
        KeyPress "1", 1
        Delay 1000
        MoveTo 835,282//鼠标移动到搜索第一格
        Delay 1000
        KeyDown "Ctrl", 1
        Delay 1000
        LeftClick 1
        Delay 1000
        KeyUp "Ctrl", 1
        KeyPress "Esc", 1
            Delay 1000
                MoveTo 1756, 90
                    LeftClick 1//点击搜索物品
                    Delay 1000
            KeyPress "M", 1
            KeyPress "A", 1
            KeyPress "X", 1
            Delay 1000
                    MoveTo 835,282//鼠标移动到搜索第一格
                    Delay 1000
                    KeyDown "Ctrl", 1
                    Delay 1000
                    LeftClick 1
                    Delay 1000
                    KeyUp "Ctrl", 1
                    Delay 1000
                    KeyPress "Esc", 2
                                Delay 1000
    Delay 1000
    KeyPress "Esc", 2//回到主页
    MoveTo 1285, 820//逃离塔科夫
    LeftClick 1
    Delay 1000
    MoveTo 1584, 394//pmc
    LeftClick 1
    Delay 1000
    MoveTo 1279, 1257//下一步
    LeftClick 1
    Delay 1000
    MoveTo 1005,575//海关
    LeftClick 1
    Delay 1000
    MoveTo 1307, 1249//下一步
    LeftClick 1
    Delay 1000
    MoveTo 1292, 1249//下一步
    LeftClick 1
    Delay 1000
    MoveTo 1292, 1249//下一步
    LeftClick 1
    Delay 1000
    MoveTo 1292, 1249//下一步
    LeftClick 1
        Delay 30000
End If
    Rem biaoji5
    IfColor 262,1382,"7E942A",2 Then//检查体力条蓝色出现在体力条位置像素点
    KeyPress "Tab", 1//打开背包
        Delay 1000
        MoveTo 1019, 492//移动到口袋第二格水的位置喝水
        LeftDoubleClick 1
        Delay 1000
        KeyPress "Tab", 1
        Delay 10000
                                    Else
    Delay 2000
        Goto biaoji5
                    End If
    Rem biaoji6
For 4//让跑体力条循环4次
                        Rem biaoji1
IfColor 262,1382,"7E942A",2 Then//如果体力条满的地方是蓝色则进行下一步
    KeyDown "W", 1
        Delay 500
        KeyPress "Shift", 1//跑起来
Else
        Delay 2000
                    IfColor 1563,1143,"B0890",2 Then//每两秒检测一下有没有死亡后的红色在指定像素点
                        Goto bioaji3//跳转到下面的死亡流程
                            Else
    Goto biaoji1//回到标记1继续检测
            End If
End If
    Rem biaoji2
    IfColor 71,1382,"000000",2 Then//检测体力条最左侧为黑色时体力为空
    KeyPress "W", 1//按一下w结束跑步
                            Else//体力不空就一直转圈
            IfColor 262,1382,"7E942A",2 Then//检测到体力条最右端变成蓝色说明停下来了，重新跑起来
                    KeyDown "W", 1
                        Delay 500
                        KeyPress "Shift", 1//跑起来
                Else//体力不空就一直转圈
        MoveRS 2000, 0
        Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
        MoveRS 2000, 0
                Delay 100
            IfColor 1563,1143,"B0890",2 Then
            Goto bioaji3//检测死了就跳转
                Else
                Goto biaoji2
                                    End If
                End If
End If
    Delay 10
Next

        Delay 10
        MoveRS 0, 2000//低头
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
        MoveRS 0, 2000
        Delay 10
KeyPress "G", 1//掏雷
Delay 2000
RightClick 1//右键丢雷
Delay 20000
Rem bioaji3
IfColor 1563,1143,"B0890",2 Then//死亡程序，找红色像素点
MoveTo 1295, 1253
    LeftClick 1
Delay 5000
MoveTo 1295, 1253
    LeftClick 1
        Delay 5000
MoveTo 1295, 1253
    LeftClick 1
        Delay 5000
MoveTo 1295, 1253
    LeftClick 1
        Delay 5000
MoveTo 1735, 1251
    LeftClick 1
        Delay 5000
MoveTo 1295, 1253
    LeftClick 1
        Delay 5000
Else
    Delay 2000
Goto bioaji3
End If
Else
        IfColor 262,1382,"7E942A",2 Then
    Goto biaoji6
        Else
    Delay 10
    KeyPress "Esc", 1
        Delay 10
    KeyPress "Esc", 1
        Delay 10
    KeyPress "Esc", 1
        Delay 1000
Goto bioaji4
        End If
End If
